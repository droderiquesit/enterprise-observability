            "monitor_thresholds": [
              {
                "critical": "0.95",
                "critical_recovery": "",
                "ok": "",
                "unknown": "",
                "warning": "0.9",
                "warning_recovery": ""
              }
            ],
            "name": "[P3][stage][infrastructure] Disk Exhaustion Forecast (critical)",
            "new_group_delay": 300,
            "new_host_delay": 300,
            "no_data_timeframe": 0,
            "notification_preset_name": "",
