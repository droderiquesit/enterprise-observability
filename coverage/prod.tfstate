            "monitor_thresholds": [
              {
                "critical": "100",
                "critical_recovery": "",
                "ok": "",
                "unknown": "",
                "warning": "50",
                "warning_recovery": ""
              }
            ],
            "name": "[P3][prod][network] Interface Error Rate Rising (standard)",
