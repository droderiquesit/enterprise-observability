{
  "version": 4,
  "terraform_version": "1.9.8",
  "serial": 478,
  "lineage": "a5a45b62-a0ad-4029-e5d1-20aff40fb070",
  "outputs": {},
  "resources": [
    {
      "module": "module.dashboards",
      "mode": "managed",
      "type": "datadog_dashboard_json",
      "name": "this",
      "provider": "provider[\"registry.terraform.io/datadog/datadog\"]",
      "instances": [
        {
          "index_key": "alert-quality",
          "schema_version": 0,
          "attributes": {
            "dashboard": "{\"description\":\"The board that keeps the platform honest. If these numbers get worse, the framework is failing regardless of how much coverage it reports. Reviewed monthly by the observability-platform team with domain owners.\",\"is_read_only\":false,\"layout_type\":\"ordered\",\"notify_list\":null,\"reflow_type\":\"auto\",\"template_variables\":[{\"default\":\"*\",\"name\":\"team\",\"prefix\":\"team\"}],\"title\":\"Alert Quality Scorecard\",\"widgets\":[{\"definition\":{\"background_color\":\"yellow\",\"content\":\"**How to read this board.** Coverage is easy to grow and easy to fake. These five numbers are the ones that decide whether on-call is sustainable:\\n\\n1. **Pages per week per team** — the burnout metric. Target \\u003c 5.\\n2. **Actionability** — share of pages that led to a change. Target \\u003e 70%.\\n3. **Auto-resolved without action** — alerts that recovered on their own. Target \\u003c 20%; higher means thresholds are wrong.\\n4. **Flapping monitors** — anything transitioning more than 4x/hour is muted and ticketed.\\n5. **Predictive share** — proportion of the estate using anomaly/forecast/outlier detection rather than fixed thresholds.\",\"font_size\":\"14\",\"show_tick\":false,\"text_align\":\"left\",\"type\":\"note\"}},{\"definition\":{\"requests\":[{\"q\":\"top(sum:datadog.monitor.alert_count{pages:true,managed_by:terraform} by {team}.as_count(), 10, 'sum', 'desc')\",\"style\":{\"palette\":\"warm\"}}],\"title\":\"Pages per team (7d) — the burnout metric\",\"type\":\"toplist\"}},{\"definition\":{\"requests\":[{\"display_type\":\"bars\",\"q\":\"sum:datadog.monitor.alert_count{priority:p1,managed_by:terraform}.as_count()\"},{\"display_type\":\"bars\",\"q\":\"sum:datadog.monitor.alert_count{priority:p2,managed_by:terraform}.as_count()\"},{\"display_type\":\"bars\",\"q\":\"sum:datadog.monitor.alert_count{priority:p3,managed_by:terraform}.as_count()\"}],\"title\":\"Alert volume by priority (30d)\",\"type\":\"timeseries\"}},{\"definition\":{\"requests\":[{\"q\":\"top(sum:datadog.monitor.alert_count{managed_by:terraform} by {monitor_id}.as_count(), 20, 'sum', 'desc')\",\"style\":{\"palette\":\"orange\"}}],\"title\":\"Noisiest monitors (30d) — candidates for retuning or deletion\",\"type\":\"toplist\"}},{\"definition\":{\"requests\":[{\"q\":\"sum:datadog.monitor.alert_count{managed_by:terraform} by {detection}.as_count()\"}],\"title\":\"Detection mix — predictive vs fixed threshold\",\"type\":\"sunburst\"}},{\"definition\":{\"precision\":0,\"requests\":[{\"conditional_formats\":[{\"comparator\":\"\\u003e\",\"palette\":\"white_on_red\",\"value\":0},{\"comparator\":\"\\u003c=\",\"palette\":\"white_on_green\",\"value\":0}],\"q\":\"max:acme.observability.unmanaged_monitor_count{*}\"}],\"title\":\"Unmanaged (click-ops) monitors — must be zero\",\"type\":\"query_value\"}},{\"definition\":{\"precision\":0,\"requests\":[{\"conditional_formats\":[{\"comparator\":\"\\u003e\",\"palette\":\"white_on_red\",\"value\":1500},{\"comparator\":\"\\u003e\",\"palette\":\"white_on_yellow\",\"value\":1200},{\"comparator\":\"\\u003c=\",\"palette\":\"white_on_green\",\"value\":1200}],\"q\":\"max:acme.observability.managed_monitor_count{*}\"}],\"title\":\"Managed monitor count against budget\",\"type\":\"query_value\"}}]}",
            "dashboard_lists": null,
            "dashboard_lists_removed": [],
            "id": "78p-dm3-jbk",
            "url": "/dashboard/78p-dm3-jbk/alert-quality-scorecard"
          },
          "sensitive_attributes": [],
          "private": "bnVsbA=="
        }
      ]
    },
