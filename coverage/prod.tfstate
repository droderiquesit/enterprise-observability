            "monitor_thresholds": [
              {
                "critical": "0.9",
                "critical_recovery": "",
                "ok": "",
                "unknown": "",
                "warning": "0.8",
                "warning_recovery": ""
              }
            ],
            "name": "[P3][prod][database] Database Connection Pool Saturation Forecast (critical)",
            "new_group_delay": 300,
            "new_host_delay": 300,
            "no_data_timeframe": 0,
            "notification_preset_name": "",
            "notify_audit": false,
            "notify_by": [],
            "notify_no_data": false,
            "on_missing_data": "",
