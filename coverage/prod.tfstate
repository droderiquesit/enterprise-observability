            "monitor_thresholds": [
              {
                "critical": "-20",
                "critical_recovery": "",
                "ok": "",
                "unknown": "",
                "warning": "-10",
                "warning_recovery": ""
              }
            ],
            "name": "[P2][prod][cloud] Redis Cache Hit Ratio Degradation (critical)",
            "new_group_delay": 300,
            "new_host_delay": 300,
            "no_data_timeframe": 0,
            "notification_preset_name": "",
            "notify_audit": false,
            "notify_by": [
              "subscription_name"
            ],
            "notify_no_data": false,
            "on_missing_data": "",
