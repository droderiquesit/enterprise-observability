            "query": "pct_change(avg(last_30m),last_4h):(sum:azure.cache_redis.cachehits{env:prod,alert_band:critical,resource_type:azure_redis} by {subscription_name,name} / (sum:azure.cache_redis.cachehits{env:prod,alert_band:critical,resource_type:azure_redis} by {subscription_name,name} + sum:azure.cache_redis.cachemisses{env:prod,alert_band:critical,resource_type:azure_redis} by {subscription_name,name})) \u003c -20",
