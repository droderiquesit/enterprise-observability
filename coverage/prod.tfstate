            "monitor_thresholds": [
              {
                "critical": "0",
                "critical_recovery": "",
                "ok": "",
                "unknown": "",
                "warning": "",
                "warning_recovery": ""
              }
            ],
            "name": "[P3][prod][messaging] Stream Partition Skew (critical)",
            "new_group_delay": 300,
            "new_host_delay": 300,
            "no_data_timeframe": 0,
            "notification_preset_name": "",
            "notify_audit": false,
            "notify_by": [
              "stream"
            ],
            "notify_no_data": false,
