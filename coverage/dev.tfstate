                "resource_key": "15298344",
                "resource_type": "notebook",
                "url": "https://app.datadoghq.com/notebook/15298344"
              }
            ],
            "draft_status": "published",
            "enable_logs_sample": null,
            "enable_samples": null,
            "escalation_message": "",
            "evaluation_delay": 300,
            "force_delete": null,
            "group_retention_duration": "",
            "groupby_simple_monitor": null,
            "id": "314985604",
            "include_tags": true,
            "locked": false,
            "message": "{{#is_alert}}\n## P4 · API Availability\n**WHAT:** API Availability: availability signal detected by threshold analysis.\n**WHERE:** {{value}} · env `dev` · region `global`\n**SERVICE:** `api-services` (api / service, tier3)\n**BUSINESS IMPACT:** Customers are affected now, or a mission-critical capability is unavailable.\n**WHY IT TRIGGERED:** More than half of requests failing is an availability boundary, not a behavioral deviation. Sub-outage degradation is caught by the anomaly and burn-rate archetypes; this one exists to fire fast and unambiguously.\n\n**OWNER:** application-development · support best-effort · this does not page\n**RUNBOOK:** attached to this monitor as `API Availability` — open it from the monitor's Runbook asset.\n**AUTOMATED DIAGNOSTICS:** workflow `diag-api-health` has run; its output is attached to this event.\n**RELATED EVENTS:** correlated on `api-services.dev.api-services` — deployments, infrastructure changes and platform events from the last 30 minutes are attached as context.\n**SLO / ERROR BUDGET:** `slo-api-availability` · no error-budget impact (non-production)\n{{/is_alert}}\n{{#is_warning}}\n## API Availability — warning\nApproaching the alert condition on {{value}}. Investigate before it becomes P4.\n{{/is_warning}}\n{{#is_no_data}}\n## API Availability — NO DATA\nTelemetry stopped arriving for {{value}}. Treat this as a telemetry-health incident: an unmonitored resource is worse than an alerting one.\n{{/is_no_data}}\n{{#is_recovery}}\n## Recovered · API Availability\n{{value}} returned to normal. Error-budget impact recorded against `slo-api-availability`. No action required; the correlation group closes when every child recovers.\n{{/is_recovery}}\n{{#is_warning_recovery}}\nWarning cleared for {{value}}.\n{{/is_warning_recovery}}",
            "monitor_threshold_windows": [],
            "monitor_thresholds": [
              {
                "critical": "0.5",
                "critical_recovery": "",
                "ok": "",
                "unknown": "",
                "warning": "0.2",
                "warning_recovery": ""
              }
            ],
            "name": "[P4][dev][api] API Availability (baseline)",
            "new_group_delay": 300,
            "new_host_delay": 300,
            "no_data_timeframe": 0,
            "notification_preset_name": "",
            "notify_audit": false,
            "notify_by": [],
            "notify_no_data": false,
            "on_missing_data": "",
            "priority": "4",
            "query": "sum(last_30m):sum:trace.http.request.hits{env:dev,alert_band:baseline,service_archetype:api,http.status_class:5xx} by {service}.as_count() / sum:trace.http.request.hits{env:dev,alert_band:baseline,service_archetype:api} by {service}.as_count() \u003e 0.5",
            "renotify_interval": 60,
            "renotify_occurrences": 3,
            "renotify_statuses": [
              "alert"
            ],
            "require_full_window": false,
            "restricted_roles": null,
            "scheduling_options": [],
            "tags": [
