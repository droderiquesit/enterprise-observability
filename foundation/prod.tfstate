        {
          "index_key": "oncall",
          "schema_version": 0,
          "attributes": {
            "dashboard": "{\"description\":\"Managed by Terraform (stacks/foundation). Everything a responder needs during a page: active alerts, correlated events, recent changes, workflow runs.\",\"is_read_only\":false,\"layout_type\":\"ordered\",\"notify_list\":null,\"reflow_type\":\"auto\",\"tags\":[\"team:observability-platform\"],\"template_variables\":[{\"default\":\"*\",\"name\":\"team\",\"prefix\":\"team\"}],\"title\":\"On-Call — Active Pages \\u0026 Correlation\",\"widgets\":[{\"definition\":{\"color_preference\":\"background\",\"count\":50,\"display_format\":\"countsAndList\",\"hide_zero_counts\":true,\"query\":\"status:(alert OR warn) tag:(pages:true) tag:($team.value)\",\"sort\":\"priority,asc\",\"start\":0,\"summary_type\":\"combined\",\"title\":\"Active pages (paging monitors only)\",\"type\":\"manage_status\"}},{\"definition\":{\"event_size\":\"l\",\"query\":\"source:alert tags:managed_by:terraform tags:$team.value\",\"title\":\"Correlated event stream (dedup by correlation_key)\",\"type\":\"event_stream\"}},{\"definition\":{\"event_size\":\"s\",\"query\":\"tags:(deployment OR audit) tags:$team.value\",\"title\":\"Recent deployments \\u0026 config changes (last 4h)\",\"type\":\"event_stream\"}},{\"definition\":{\"background_color\":\"yellow\",\"content\":\"## Responder crib sheet\\n\\n1. Ack the page (5/10 min SLA by severity).\\n2. Open the **runbook** linked in the alert — diagnostics workflow output is attached to the event.\\n3. Check *Recent changes* above: most pages resolve to a deployment.\\n4. Escalation: ack timeout auto-escalates via the team escalation policy; manual escalation handles are in the runbook.\\n5. Sev1: incident is auto-created — join the incident channel.\",\"font_size\":\"14\",\"show_tick\":false,\"text_align\":\"left\",\"type\":\"note\"}}]}",
            "dashboard_lists": null,
            "dashboard_lists_removed": [],
            "id": "7sz-pv9-fcn",
            "url": "/dashboard/7sz-pv9-fcn/on-call--active-pages--correlation"
          },
          "sensitive_attributes": [],
          "private": "bnVsbA=="
        },
        {
          "index_key": "operations-overview",
          "schema_version": 0,
          "attributes": {
            "dashboard": "{\"description\":\"Managed by Terraform (stacks/foundation). One row per domain; drill into the domain dashboards for detail.\",\"is_read_only\":false,\"layout_type\":\"ordered\",\"notify_list\":null,\"reflow_type\":\"auto\",\"tags\":[\"team:observability-platform\"],\"template_variables\":[{\"available_values\":[\"prod\",\"staging\"],\"default\":\"prod\",\"name\":\"env\",\"prefix\":\"env\"}],\"title\":\"Operations Overview — Infrastructure, Cloud, Data, Security, SRE\",\"widgets\":[{\"definition\":{\"color_preference\":\"background\",\"count\":50,\"display_format\":\"countsAndList\",\"hide_zero_counts\":true,\"query\":\"tag:(managed_by:terraform) tag:($env.value)\",\"sort\":\"status,asc\",\"start\":0,\"summary_type\":\"groups\",\"title\":\"Alerting monitors by domain\",\"type\":\"manage_status\"}},{\"definition\":{\"requests\":[{\"display_type\":\"line\",\"queries\":[{\"data_source\":\"metrics\",\"name\":\"q1\",\"query\":\"sum:datadog.host.count{*}\"}],\"response_format\":\"timeseries\"}],\"title\":\"Infrastructure — host fleet\",\"type\":\"timeseries\"}},{\"definition\":{\"requests\":[{\"display_type\":\"line\",\"queries\":[{\"data_source\":\"metrics\",\"name\":\"q1\",\"query\":\"sum:kubernetes_state.deployment.replicas_available{$env} by {kube_cluster_name}\"}],\"response_format\":\"timeseries\"}],\"title\":\"Cloud — K8s workload availability\",\"type\":\"timeseries\"}},{\"definition\":{\"requests\":[{\"display_type\":\"line\",\"queries\":[{\"data_source\":\"metrics\",\"name\":\"q1\",\"query\":\"max:acme.data.pipeline.freshness_minutes{$env} by {pipeline}\"}],\"response_format\":\"timeseries\"}],\"title\":\"Data — pipeline freshness (minutes)\",\"type\":\"timeseries\"}},{\"definition\":{\"requests\":[{\"display_type\":\"bars\",\"queries\":[{\"data_source\":\"metrics\",\"name\":\"q1\",\"query\":\"sum:acme.security.log_sources_reporting{$env} by {log_source}\"}],\"response_format\":\"timeseries\"}],\"title\":\"Security — log sources reporting\",\"type\":\"timeseries\"}},{\"definition\":{\"requests\":[{\"display_type\":\"line\",\"queries\":[{\"data_source\":\"metrics\",\"name\":\"q1\",\"query\":\"sum:trace.http.request.errors{$env} by {service}.as_rate()\"}],\"response_format\":\"timeseries\"}],\"title\":\"SRE — service error rate\",\"type\":\"timeseries\"}}]}",
            "dashboard_lists": null,
            "dashboard_lists_removed": [],
