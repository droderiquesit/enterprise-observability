        {
          "index_key": "custom.prod.settlement-partner-file-sla",
          "schema_version": 0,
          "attributes": {
            "assets": [
              {
                "category": "runbook",
                "name": "Partner File Delivery Missed",
                "resource_key": "15298666",
                "resource_type": "notebook",
