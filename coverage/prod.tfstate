            "notification_preset_name": "",
            "notify_audit": false,
            "notify_by": [
              "name"
            ],
            "notify_no_data": false,
            "on_missing_data": "",
            "priority": "1",
            "query": "min(last_10m):min:azure.network_trafficmanagerprofiles.probe_agent_current_endpoint_state_by_profile_resource_id{env:prod,alert_band:critical,resource_type:azure_traffic_manager} by {name,endpoint_name} \u003c 1",
