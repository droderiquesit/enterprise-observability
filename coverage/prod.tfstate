            "query": "max(next_1d):forecast(sum:api.gateway.requests{env:prod,alert_band:critical,service_archetype:api} by {service}.as_rate() / avg:api.gateway.rate_limit{env:prod,alert_band:critical,service_archetype:api} by {service}, 'linear', 1, interval='15m', history='2d') \u003e 0.9",
