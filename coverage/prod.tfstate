              "dedup_key:database-platform.prod.sqlserver-tempdb-version-store-growth.critical",
              "detection:anomaly",
              "domain:database",
              "env:prod",
              "failure_domain:databases",
              "impact_class:risk",
              "managed_by:terraform",
              "managed_source:platform",
              "monitor_id:prod.critical.database.sqlserver-tempdb-version-store-growth",
              "monitoring_profile:critical",
