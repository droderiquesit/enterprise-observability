              "detection:forecast",
              "domain:saas",
              "env:prod",
              "failure_domain:saas-dependency",
              "impact_class:risk",
              "managed_by:terraform",
              "managed_source:platform",
              "monitor_id:prod.standard.saas.saas-quota-forecast",
              "monitoring_profile:standard",
              "notification_profile:production_standard",
              "owner:sre",
