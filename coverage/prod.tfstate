      "instances": [
        {
          "index_key": "burn.prod.slo-api-availability.fast",
          "schema_version": 0,
          "attributes": {
            "assets": [],
            "draft_status": "published",
            "enable_logs_sample": null,
            "enable_samples": null,
            "escalation_message": "",
