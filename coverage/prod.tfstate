            "new_host_delay": 300,
            "no_data_timeframe": 0,
            "notification_preset_name": "",
            "notify_audit": false,
            "notify_by": [],
            "notify_no_data": false,
            "on_missing_data": "",
            "priority": "2",
            "query": "avg(last_30m):anomalies(sum:trace.http.request.hits{env:prod,alert_band:critical,service_archetype:api,http.status_class:4xx} by {service}.as_rate(), 'agile', 4) \u003e= 1",
