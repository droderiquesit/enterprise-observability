            "monitor_thresholds": [
              {
                "critical": "0.9",
                "critical_recovery": "",
                "ok": "",
                "unknown": "",
                "warning": "0.8",
                "warning_recovery": ""
              }
            ],
            "name": "[P3][prod][saas] SaaS API Quota Exhaustion Forecast (critical)",
