{
  "title": "Alert Quality Scorecard",
  "description": "The board that keeps the platform honest. If these numbers get worse, the framework is failing regardless of how much coverage it reports. Reviewed monthly by the observability-platform team with domain owners.",
  "layout_type": "ordered",
  "reflow_type": "auto",
  "template_variables": [
    { "name": "team", "prefix": "team", "default": "*" }
  ],
  "widgets": [
    {
      "definition": {
        "type": "note",
        "content": "**How to read this board.** Coverage is easy to grow and easy to fake. These five numbers are the ones that decide whether on-call is sustainable:\n\n1. **Pages per week per team** — the burnout metric. Target < 5.\n2. **Actionability** — share of pages that led to a change. Target > 70%.\n3. **Auto-resolved without action** — alerts that recovered on their own. Target < 20%; higher means thresholds are wrong.\n4. **Flapping monitors** — anything transitioning more than 4x/hour is muted and ticketed.\n5. **Predictive share** — proportion of the estate using anomaly/forecast/outlier detection rather than fixed thresholds.",
        "background_color": "yellow",
        "font_size": "14",
        "text_align": "left",
        "show_tick": false
      }
    },
    {
      "definition": {
        "title": "Pages per team (7d) — the burnout metric",
        "type": "toplist",
        "requests": [{
          "q": "top(sum:datadog.monitor.alert_count{pages:true,managed_by:terraform} by {team}.as_count(), 10, 'sum', 'desc')",
          "style": { "palette": "warm" }
        }]
      }
    },
    {
      "definition": {
        "title": "Alert volume by priority (30d)",
        "type": "timeseries",
        "requests": [
          { "q": "sum:datadog.monitor.alert_count{priority:p1,managed_by:terraform}.as_count()", "display_type": "bars" },
          { "q": "sum:datadog.monitor.alert_count{priority:p2,managed_by:terraform}.as_count()", "display_type": "bars" },
          { "q": "sum:datadog.monitor.alert_count{priority:p3,managed_by:terraform}.as_count()", "display_type": "bars" }
        ]
      }
    },
    {
      "definition": {
        "title": "Noisiest monitors (30d) — candidates for retuning or deletion",
        "type": "toplist",
        "requests": [{
          "q": "top(sum:datadog.monitor.alert_count{managed_by:terraform} by {monitor_id}.as_count(), 20, 'sum', 'desc')",
          "style": { "palette": "orange" }
        }]
      }
    },
    {
      "definition": {
        "title": "Detection mix — predictive vs fixed threshold",
        "type": "sunburst",
        "requests": [{
          "q": "sum:datadog.monitor.alert_count{managed_by:terraform} by {detection}.as_count()"
        }]
      }
    },
    {
      "definition": {
        "title": "Unmanaged (click-ops) monitors — must be zero",
        "type": "query_value",
        "requests": [{
          "q": "max:acme.observability.unmanaged_monitor_count{*}",
          "conditional_formats": [
            { "comparator": ">", "value": 0, "palette": "white_on_red" },
            { "comparator": "<=", "value": 0, "palette": "white_on_green" }
          ]
        }],
        "precision": 0
      }
    },
    {
      "definition": {
        "title": "Managed monitor count against budget",
        "type": "query_value",
        "requests": [{
          "q": "max:acme.observability.managed_monitor_count{*}",
          "conditional_formats": [
            { "comparator": ">", "value": 1500, "palette": "white_on_red" },
            { "comparator": ">", "value": 1200, "palette": "white_on_yellow" },
            { "comparator": "<=", "value": 1200, "palette": "white_on_green" }
          ]
        }],
        "precision": 0
      }
    }
  ]
}
