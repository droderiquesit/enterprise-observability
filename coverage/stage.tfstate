                "resource_key": "15320573",
                "resource_type": "notebook",
                "url": "https://app.datadoghq.com/notebook/15320573"
              }
            ],
            "draft_status": "published",
            "enable_logs_sample": null,
            "enable_samples": null,
            "escalation_message": "",
            "evaluation_delay": 300,
            "force_delete": null,
            "group_retention_duration": "",
            "groupby_simple_monitor": null,
            "id": "315065757",
            "include_tags": true,
            "locked": false,
            "message": "{{#is_alert}}\n## P3 · Control-M Job Ended Not OK\n**WHAT:** Deliberately separate from the generic `batch-job-failure`: that one reads `acme.batch.runs` from application batch runners, this one reads the scheduler's own verdict for the jobs Control-M owns. A job can fail in Control-M without the application ever emitting a run metric — the agent could not start it, the script was missing, the host was down.\n\n**WHERE:** {{value}} · env `stage` · region `global`\n**SERVICE:** `batch-platform` (integration / controlm_job, tier2)\n**BUSINESS IMPACT:** The service still functions but measurably worse; a subset of traffic or users is failing.\n**WHY IT TRIGGERED:** An Ended Not OK run is a discrete outcome.\n**OWNER:** application-development · support business-hours · this does not page\n**RUNBOOK:** attached to this monitor as `Control-M Job Ended Not OK` — open it from the monitor's Runbook asset.\n**AUTOMATED DIAGNOSTICS:** workflow `remediate-rerun-job` has run; its output is attached to this event.\n**RELATED EVENTS:** correlated on `batch-platform.stage.batch-platform` — deployments, infrastructure changes and platform events from the last 30 minutes are attached as context.\n**SLO / ERROR BUDGET:** `slo-batch-completion` · no error-budget impact (non-production)\n{{/is_alert}}\n{{#is_warning}}\n## Control-M Job Ended Not OK — warning\nApproaching the alert condition on {{value}}. Investigate before it becomes P3.\n{{/is_warning}}\n{{#is_no_data}}\n## Control-M Job Ended Not OK — NO DATA\nTelemetry stopped arriving for {{value}}. Treat this as a telemetry-health incident: an unmonitored resource is worse than an alerting one.\n{{/is_no_data}}\n{{#is_recovery}}\n## Recovered · Control-M Job Ended Not OK\n{{value}} returned to normal. Error-budget impact recorded against `slo-batch-completion`. No action required; the correlation group closes when every child recovers.\n{{/is_recovery}}\n{{#is_warning_recovery}}\nWarning cleared for {{value}}.\n{{/is_warning_recovery}}",
            "monitor_threshold_windows": [],
            "monitor_thresholds": [
              {
                "critical": "1",
                "critical_recovery": "",
                "ok": "",
                "unknown": "",
                "warning": "",
                "warning_recovery": ""
              }
            ],
            "name": "[P3][stage][integration] Control-M Job Ended Not OK (standard)",
            "new_group_delay": 300,
            "new_host_delay": 300,
            "no_data_timeframe": 0,
            "notification_preset_name": "",
            "notify_audit": false,
            "notify_by": [],
            "notify_no_data": false,
            "on_missing_data": "",
            "priority": "3",
            "query": "sum(last_4h):sum:controlm.job.status{env:stage,alert_band:standard,resource_type:controlm_job,job_status:failed} by {folder,job_name}.as_count() \u003e= 1",
