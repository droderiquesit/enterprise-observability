            "no_data_timeframe": 0,
            "notification_preset_name": "",
            "notify_audit": false,
            "notify_by": [],
            "notify_no_data": false,
            "on_missing_data": "",
            "priority": "1",
            "query": "sum(last_5m):sum:trace.http.request.hits{env:prod,alert_band:critical,service_archetype:api,http.status_class:5xx} by {service}.as_count() / sum:trace.http.request.hits{env:prod,alert_band:critical,service_archetype:api} by {service}.as_count() \u003e 0.5",
