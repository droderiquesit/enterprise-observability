# Remote state backend configuration. Copy to backend.prod.hcl in CI from the
# secret store; NEVER commit real values.
#
#   terraform init -backend-config=../backend.prod.hcl
#
storage_account_name = "acmeobsstate"
container_name       = "tfstate"
key                  = "observability/<stack>.tfstate"
use_azuread_auth     = true
