              "priority:p3",
              "request_id:checkout-payment-latency",
              "request_source:self_service",
              "resource_type:service",
              "runbook:api-latency-p99",
              "service:checkout-api",
              "signal:latency",
              "slo_id:slo-api-latency",
              "support_model:24x7",
              "team:payments",
              "tier:tier0"
            ],
            "timeout_h": 0,
            "type": "query alert",
