          "index_key": "checkout-api",
          "schema_version": 0,
          "attributes": {
            "id": "checkout-api",
            "service_definition": "contacts:\n    - contact: payments@acme.example\n      name: payments email\n      type: email\ndd-service: checkout-api\ndescription: Customer checkout and payment orchestration API.\nlifecycle: production\nlinks:\n    - name: Architecture\n      type: doc\n      url: https://wiki.acme.example/checkout\n    - name: Repository\n      type: repo\n      url: https://github.com/acme/checkout-api\n    - name: 'Runbook: API 4xx Client Error Anomaly'\n      type: runbook\n      url: https://app.datadoghq.com/notebook/15298341\n    - name: 'Runbook: API 5xx Error Rate Anomaly'\n      type: runbook\n      url: https://app.datadoghq.com/notebook/15298343\n    - name: 'Runbook: API Availability'\n      type: runbook\n      url: https://app.datadoghq.com/notebook/15298344\n    - name: 'Runbook: API Downstream Dependency Latency'\n      type: runbook\n      url: https://app.datadoghq.com/notebook/15298346\n    - name: 'Runbook: API Rate Limit Saturation'\n      type: runbook\n      url: https://app.datadoghq.com/notebook/15298353\n    - name: 'Runbook: API Traffic Drop Anomaly'\n      type: runbook\n      url: https://app.datadoghq.com/notebook/15298354\n    - name: 'Runbook: API p99 Latency Degradation'\n      type: runbook\n      url: https://app.datadoghq.com/notebook/15298349\n    - name: 'Runbook: Application Crash / Fatal Error Anomaly'\n      type: runbook\n      url: https://app.datadoghq.com/notebook/15298356\n    - name: 'Runbook: Application Memory Exhaustion Forecast'\n      type: runbook\n      url: https://app.datadoghq.com/notebook/15298358\n    - name: 'Runbook: Application Runtime Saturation'\n      type: runbook\n      url: https://app.datadoghq.com/notebook/15298359\n    - name: 'Runbook: Application Stopped Reporting Telemetry'\n      type: runbook\n      url: https://app.datadoghq.com/notebook/15298361\n    - name: 'Runbook: Deployment Regression'\n      type: runbook\n      url: https://app.datadoghq.com/notebook/15208649\n    - name: 'Runbook: Outbound Dependency Failure'\n      type: runbook\n      url: https://app.datadoghq.com/notebook/15298615\n    - name: 'Runbook: Outbound Dependency Latency Degradation'\n      type: runbook\n      url: https://app.datadoghq.com/notebook/15298616\n    - name: 'Runbook: Post-Deployment Error Spike'\n      type: runbook\n      url: https://app.datadoghq.com/notebook/15298617\nschema-version: v2.2\ntags:\n    - criticality:tier0\n    - domain:api\n    - env:prod\n    - managed_by:terraform\n    - monitoring_profile:critical\nteam: payments\ntier: tier0\n"
