          "schema_version": 0,
          "attributes": {
            "dashboard": "{\"description\":\"Managed by Terraform (stacks/foundation). SLO health, error-budget risk, active incidents, coverage and ownership gaps.\",\"is_read_only\":false,\"layout_type\":\"ordered\",\"notify_list\":null,\"reflow_type\":\"auto\",\"tags\":[\"team:observability-platform\"],\"template_variables\":null,\"title\":\"Enterprise Overview — SLO Health \\u0026 Platform Risk\",\"widgets\":[{\"definition\":{\"requests\":[{\"query\":{\"limit\":100,\"query_string\":\"tags:(managed_by:terraform)\",\"sort\":[{\"column\":\"status.sli\",\"order\":\"asc\"}]},\"request_type\":\"slo_list\"}],\"title\":\"SLO health (all platform SLOs)\",\"type\":\"slo_list\"}},{\"definition\":{\"color_preference\":\"background\",\"count\":50,\"display_format\":\"countsAndList\",\"hide_zero_counts\":true,\"query\":\"tag:(managed_by:terraform AND pages:true)\",\"sort\":\"priority,asc\",\"start\":0,\"summary_type\":\"monitors\",\"title\":\"Error-budget risk — monitors in alert by severity\",\"type\":\"manage_status\"}},{\"definition\":{\"custom_links\":[],\"precision\":0,\"requests\":[{\"queries\":[{\"aggregator\":\"last\",\"data_source\":\"metrics\",\"name\":\"gaps\",\"query\":\"sum:acme.observability.coverage.gaps{report:latest}\"}],\"response_format\":\"scalar\"}],\"title\":\"Coverage \\u0026 governance gaps (from coverage report)\",\"type\":\"query_value\"}},{\"definition\":{\"precision\":0,\"requests\":[{\"queries\":[{\"aggregator\":\"last\",\"data_source\":\"metrics\",\"name\":\"unowned\",\"query\":\"sum:acme.observability.coverage.unowned{report:latest}\"}],\"response_format\":\"scalar\"}],\"title\":\"Unowned resources (must be zero)\",\"type\":\"query_value\"}},{\"definition\":{\"background_color\":\"gray\",\"content\":\"## How to read this dashboard\\n\\n**Coverage metrics** are published by tools/coverage_report.py (scheduled in CI). Gaps \\u003e 0 page the observability-platform team via the platform-governance archetype. Per-service drill-down: use the native Service Catalog — no custom per-service dashboards exist by design.\",\"font_size\":\"14\",\"show_tick\":false,\"text_align\":\"left\",\"type\":\"note\"}}]}",
            "dashboard_lists": null,
            "dashboard_lists_removed": [],
            "id": "34k-sgg-qhg",
